params {
  project_folder   = "$PWD"
  frip_output      = "frip_output"
  frip_samplesheet = null
  samples_master   = null
  chipfilter_output = "/ictstr01/groups/idc/projects/uhlenhaut/jiang/pipelines/nf-chipfilter/chipfilter_output"
  idr_output       = "/ictstr01/groups/idc/projects/uhlenhaut/jiang/pipelines/nf-idr/idr_output"
  frip_peak_mode   = "condition"   // condition or sample
  frip_peak_suffix = "_idr.sorted.chr.narrowPeak"
  frip_include_controls = false

  container_frip = "/ictstr01/groups/idc/projects/uhlenhaut/jiang/singularity_image/chipfilter-sam-bed.sif"
  queue = 'cpu_p'

  cpus   = 2
  memory = '8 GB'
  time   = '2h'
}

profiles {
  local { includeConfig 'configs/local.config' }
  hpc   { includeConfig 'configs/slurm.config' }
}
